# Worktree Manager Environment Variables
# Copy this file to .env and fill in your values

# Development
RUST_LOG=debug
RUST_BACKTRACE=1

# Devcontainer Configuration
# Location of shared tool configs (.codex, .claude-code, .gh) for volume mounts
# Default: ../.. (parent directory - shares configs across all worktrees)
# Non-worktree setup: use .. (project root)
# Custom: use any absolute or relative path
# SHARED_CONFIG_DIR=../..

# BranchBox configuration (required for feature worktrees)
# Note: WORK_FEATURE and DEVCONTAINER_NAME are set automatically per worktree
APP_URL=dev.localhost
# Optional: explicitly set the base app name used for devcontainer/project labels
# APP_NAME=branchbox

# Control Plane (optional - only needed for remote features)
# CONTROL_PLANE_URL=https://worktree.example.com
# DEVICE_TOKEN=your-device-token-here

# Cloudflare (optional - for tunnel provisioning)
# CLOUDFLARE_API_KEY=your-api-key-here
# CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# Tailscale (optional - for remote device communication)
# TAILSCALE_AUTHKEY=your-authkey-here
