{
  "containerEnv": {
    "DOCKER_CONTAINER": "true",
    "RUST_BACKTRACE": "1"
  },
  "remoteEnv": {
    "SSH_AUTH_SOCK": "${localEnv:SSH_AUTH_SOCK}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "serayuzgur.crates",
        "vadimcn.vscode-lldb",
        "ms-vscode.makefile-tools",
        "KnisterPeter.vscode-github",
        "GitHub.vscode-github-actions",
        "johnpapa.vscode-peacock"
      ],
      "settings": {
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer",
          "editor.formatOnSave": true
        },
        "rust-analyzer.cargo.features": "all",
        "rust-analyzer.check": {
          "command": "clippy"
        },
        "rust-analyzer.checkOnSave": true
      }
    }
  },
  "dockerComposeFile": "compose.yaml",
  "runServices": [
    "rust-dev"
  ],
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": "false"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/rbarazi/devcontainer-features/ai-npm-packages:1": {}
  },
  "forwardPorts": [
    50515,
    8787
  ],
  "name": "Worktree Manager",
  "postCreateCommand": "bash -c 'sudo chown -R vscode:rustlang /usr/local/cargo 2>/dev/null || true && cargo --version && rustc --version && echo \"SwiftUI builds run on macOS hosts; skipping swift package resolve\"'",
  "postStartCommand": "bash -c 'mkdir -p ~/.ssh && ssh-keyscan github.com >> ~/.ssh/known_hosts 2>/dev/null; cd \"${WORKSPACE_FOLDER:-.}\" && bash .devcontainer/scripts/ensure-gitdir.sh'",
  "service": "rust-dev",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached"
}
