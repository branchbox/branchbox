{
  "name": "branchbox-remotion-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion teaser composition for BranchBox demos",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts BranchBoxTeaser out/branchbox-teaser.mp4 --codec=h264 --overwrite",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.424"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.424",
    "@types/node": "22.13.4",
    "@types/react": "19.0.10",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.0"
  }
}
