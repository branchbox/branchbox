# Rust Project Environment Variables

RUST_LOG=debug
RUST_BACKTRACE=1

# Devcontainer Configuration
# Location of shared tool configs (.codex, .claude, .gh) for volume mounts
# Default: ../.. (parent directory - shares configs across all worktrees)
# Non-worktree setup: use .. (project root)
# Custom: use any absolute or relative path
# SHARED_CONFIG_DIR=../..

# Devcontainer sync strategy (copy or symlink; default is copy)
# BRANCHBOX_DEVCONTAINER_STRATEGY=copy

# BranchBox configuration (required for feature worktrees)
# Note: WORK_FEATURE and DEVCONTAINER_NAME are set automatically per worktree
APP_URL=dev.localhost
# Optional: explicitly set the base app name used for devcontainer/project labels
# APP_NAME=branchbox
