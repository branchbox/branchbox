{
  "name": "Rails Project",
  "dockerComposeFile": "compose.yaml",
  "service": "rails-app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "containerEnv": {
    "DOCKER_CONTAINER": "true",
    "PATH": "/home/vscode/.local/share/mise/shims:/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "remoteEnv": {
    "SSH_AUTH_SOCK": "${localEnv:SSH_AUTH_SOCK}"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": "false"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/rbarazi/devcontainer-features/ai-npm-packages:1": {},
    "ghcr.io/rails/devcontainer/features/activestorage": {}
  },
  "forwardPorts": [3000],
  "postCreateCommand": "mise trust --all && mise install && mise exec -- bin/setup",
  "postStartCommand": "mkdir -p ~/.ssh && ssh-keyscan github.com >> ~/.ssh/known_hosts 2>/dev/null || true",
  "runArgs": [
    "--env-file",
    "../.env",
    "--ipc=host",
    "--shm-size=1gb",
    "--init"
  ]
}
