# BranchBox devcontainer overrides (auto-generated)
# This placeholder ensures docker compose env_file entries resolve even
# before BranchBox workflows populate per-worktree values.
WORK_FEATURE=main
BRANCHBOX_MAIN_NAME=main
GIT_BRANCH=main

# Shared config directory for AI coding agents and CLI tools
# This path is relative to the compose file location (.devcontainer/)
# Default ../.. points to the worktree parent directory, enabling shared
# credentials across all feature worktrees (.claude, .codex, .gh)
SHARED_CONFIG_DIR=../..
