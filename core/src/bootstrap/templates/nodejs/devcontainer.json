{
  "name": "Node.js Project",
  "dockerComposeFile": "compose.yaml",
  "service": "nodejs-app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "containerEnv": {
    "DOCKER_CONTAINER": "true"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": "false"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/rbarazi/devcontainer-features/ai-npm-packages:1": {}
  },
  "forwardPorts": [3000],
  "initializeCommand": "bash -c 'cd \"${localWorkspaceFolder}\" && bash .devcontainer/scripts/init-host.sh'",
  "postCreateCommand": "mise trust --all && mise install && mise exec -- npm install",
  "postStartCommand": "bash -c 'cd \"${WORKSPACE_FOLDER:-.}\" && bash .devcontainer/scripts/setup-git.sh'",
  "runArgs": [
    "--env-file",
    "../.env",
    "--ipc=host",
    "--shm-size=1gb",
    "--init"
  ]
}
